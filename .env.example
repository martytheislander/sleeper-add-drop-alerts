# Which trends to alert on: add, drop, or add,drop
ALERT_KINDS=add,drop

# How often to poll (4 API calls per poll). Counts are hourly windows, so 2-5 min is plenty.
POLL_SECONDS=120

# Surge rule: short-window count vs. the player's usual hourly rate, divided by the
# market-wide factor (so platform-wide waves don't count).
SHORT_HOURS=1
LONG_HOURS=24
TRENDING_LIMIT=100
MIN_COUNT=3000        # ignore players with fewer than this many adds/drops in the short window
MIN_RATIO=1.5        # market-adjusted: 2.0 = moving twice as fast as normal vs. everyone else

# Players you don't want alerts for (routine weekly streaming churn)
EXCLUDE_POSITIONS=K,DEF

# At most this many players per text; one text per poll
MAX_ALERTS_PER_POLL=5

# Re-alert rules for the same player
COOLDOWN_MINUTES=180
ESCALATION_FACTOR=2.0  # ...unless the count has grown to this multiple of the last alert's count

# Twilio (leave blank to print alerts to the console)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+15550000000
SMS_TO=+15551111111